          ) : (
            <>
              <div className="fg"><label className="fl">Nome do produto</label><input className="fi" placeholder="Ex: iPhone 16 Pro" value={apNP.name} onChange={e=>setApNP(p=>({...p,name:e.target.value}))} autoFocus /></div>
              <div className="fg"><label className="fl">Categoria (opcional)</label><input className="fi" placeholder="Ex: Smartphones" value={apNP.category} onChange={e=>setApNP(p=>({...p,category:e.target.value}))} /></div>
              <div className="fg"><label className="fl">Variação (deixe em branco para produto simples)</label><input className="fi" placeholder="Ex: 256GB, Preto, Padrão..." value={apNP.varLabel} onChange={e=>setApNP(p=>({...p,varLabel:e.target.value}))} /></div>
            </>
