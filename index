// ─── REPORT ──────────────────────────────────────────────────────────────────
function Report({ products, stores, rates, convCurrency, base }) {
  const rows = useMemo(() => {
    const list = [];
    products.forEach(prod => {
      const priceRows = getPriceRows(prod);
      priceRows.forEach(row => {
        if (!row.prices.length) return;
        const sorted = [...row.prices].map(e => {
          const store = stores.find(s => s.id === e.storeId);
          return { ...e, store, brl: toBase(e.amount, e.currency, rates, base), isFav: row.favorite === e.id };
        }).sort((a,b) => a.brl - b.brl);
        list.push({ prod, row, sorted, favId: row.favorite });
      });
    });
    return list;
  }, [products, stores, rates, base]);

  const totalSaved = rows.reduce((s,{sorted}) => {
    if (sorted.length < 2) return s;
    return s + (sorted[sorted.length-1].brl - sorted[0].brl);
  }, 0);

  return (
    <div className="page">
      <div className="sec-hd"><div className="sec-title">Relatório</div><div className="sec-sub">Comparativo</div></div>
      {totalSaved > 0 && (
        <div style={{background:"var(--greenT)",border:"1px solid var(--green)",borderRadius:14,padding:"14px 16px",marginBottom:14,display:"flex",alignItems:"center",gap:10}}>
          <div style={{fontSize:24}}>💡</div>
          <div>
            <div style={{fontSize:13,fontWeight:600,color:"var(--green)"}}>Economia potencial</div>
            <div style={{fontSize:20,fontWeight:700}}>{fmtAmt(totalSaved,base)}</div>
            <div style={{fontSize:12,color:"var(--muted)"}}>comprando sempre na loja mais barata</div>
          </div>
        </div>
      )}
      {rows.length === 0 && <div className="empty"><div className="empty-ico">📊</div><div className="empty-t">Sem dados</div><div className="empty-s">Adicione produtos com preços em múltiplas lojas</div></div>}
      {rows.map(({ prod, row, sorted, favId }) => {
        const diff = sorted.length > 1 ? sorted[sorted.length-1].brl - sorted[0].brl : 0;
        const hasFav = !!favId;
        return (
          <div className="rep-card" key={prod.id+"-"+row.key}>
            <div style={{padding:14,borderBottom:"1px solid var(--border)"}}>
              <div style={{fontSize:15,fontWeight:700}}>{prod.name}</div>
              {row.label && <div style={{fontSize:12,color:"var(--muted)",marginTop:2}}>⎇ {row.label}</div>}
              {(diff > 0 || hasFav) && (
                <div style={{marginTop:6,display:"flex",alignItems:"center",gap:8,flexWrap:"wrap"}}>
                  {diff > 0 && <span style={{fontSize:12,color:"var(--green)",fontWeight:600}}>💰 Economize {fmtAmt(diff,base)} ({((diff/sorted[sorted.length-1].brl)*100).toFixed(0)}%)</span>}
                  {hasFav && <span style={{fontSize:12,color:"var(--gold)",fontWeight:600}}>★ Favorito marcado</span>}
                </div>
              )}
            </div>
            {sorted.map((e,i) => {
              const isWinner = i === 0;
              const isFav = e.isFav;
              // Background: fav gets gold tint, winner gets green tint
              const rowBg = isFav ? "var(--goldT)" : isWinner ? "var(--greenT)" : "transparent";
              const priceColor = isFav ? "var(--gold)" : isWinner ? "var(--green)" : "var(--text)";
              return (
                <div key={e.id} style={{display:"flex",alignItems:"center",gap:10,padding:"11px 14px",borderBottom:"1px solid var(--border)",background:rowBg}}>
                  <div style={{fontSize:18}}>{storeFlag(e.store)}</div>
                  <div style={{flex:1,minWidth:0}}>
                    <div style={{fontWeight:500,overflow:"hidden",textOverflow:"ellipsis",whiteSpace:"nowrap"}}>{e.store?.name||"—"}</div>
                    {e.currency !== base && <div style={{fontSize:11,color:"var(--muted)"}}>{fmtAmt(e.amount,e.currency)}</div>}
                    <div style={{display:"flex",gap:6,marginTop:2,flexWrap:"wrap"}}>
                      {isWinner && sorted.length > 1 && <span style={{fontSize:10,color:"var(--green)",fontWeight:700}}>✓ MAIS BARATO</span>}
                      {isFav && <span style={{fontSize:10,color:"var(--gold)",fontWeight:700}}>★ FAVORITO</span>}
                    </div>
                  </div>
                  <div style={{textAlign:"right",flexShrink:0}}>
                    <div style={{fontSize:15,fontWeight:700,color:priceColor}}>{fmtAmt(e.brl,base)}</div>
                  </div>
                </div>
              );
            })}
          </div>
        );
      })}
    </div>
  );
}

// ─── CONFIG ──────────────────────────────────────────────────────────────────
function Config({ rates, setRates, convCurrency, setConvCurrency, base, setBase }) {
  const [fetchStatus, setFetchStatus] = useState(null);
  const [fetchMsg,    setFetchMsg]    = useState("");
  const [selecting,   setSelecting]   = useState(null);
  const ALL_CONV = ["USD","EUR","JPY","GBP","PYG","ARS","CLP"];
  const ALL_8 = ["BRL","USD","EUR","JPY","GBP","PYG","ARS","CLP"];

  async function fetchRates() {
    setFetchStatus("loading"); setFetchMsg("Buscando cotações...");
    try {
      // Try primary API (open.er-api — free, no key needed, has most currencies)
      let rBRL = null;
      let dateStr = "";

      try {
        const res = await fetch("https://open.er-api.com/v6/latest/BRL");
        if (res.ok) {
          const data = await res.json();
          if (data.result === "success") {
            rBRL = data.rates;
            dateStr = data.time_last_update_utc
              ? new Date(data.time_last_update_utc).toLocaleDateString("pt-BR") : "";
          }
        }
      } catch(_) {}

      // Fallback: frankfurter.app (ECB rates — no ARS/PYG but good for others)
      // For ARS and PYG we use a secondary call to exchangerate.host
      if (!rBRL) {
        // Try exchangerate.host as full fallback
        const res2 = await fetch("https://api.exchangerate-api.com/v4/latest/BRL");
        if (!res2.ok) throw new Error("Sem resposta das APIs de câmbio");
        const data2 = await res2.json();
        rBRL = data2.rates;
      }

      // If primary worked but ARS or PYG missing, try secondary for those
      const missing = ALL_CONV.filter(c => !rBRL[c]);
      if (missing.length > 0) {
        try {
          const res3 = await fetch("https://api.exchangerate-api.com/v4/latest/BRL");
          if (res3.ok) {
            const data3 = await res3.json();
            missing.forEach(c => { if (data3.rates[c]) rBRL[c] = data3.rates[c]; });
          }
        } catch(_) {}
      }

      // Convert: rBRL[c] = units of c per 1 BRL
      // We need: how many BASE units per 1 c
      const nr = {};
      const baseInBRL = base === "BRL" ? 1 : (rBRL[base] ? 1/rBRL[base] : 1);
      ALL_CONV.forEach(c => {
        if (!rBRL[c]) return;
        // 1 c = (1/rBRL[c]) BRL = (1/rBRL[c]) / (1/rBRL[base]) base units
        const cInBRL = 1 / rBRL[c];
        nr[c] = base === "BRL" ? cInBRL : cInBRL / baseInBRL;
      });

      setRates(prev => ({...prev,...nr}));
      const found = ALL_CONV.filter(c => nr[c]);
      const notFound = ALL_CONV.filter(c => !nr[c]);
      let msg = "Atualizado" + (dateStr ? " em " + dateStr : "") + " ✓";
      if (notFound.length) msg += ` (sem dados: ${notFound.join(", ")})`;
      setFetchStatus("ok"); setFetchMsg(msg);
    } catch(e) { setFetchStatus("err"); setFetchMsg("Falha: "+(e.message||"sem conexão")); }
  }

  return (
    <div className="page">
      <div className="sec-title" style={{marginBottom:20}}>Conversão</div>
      <div style={{marginBottom:24}}>
        <div style={{fontSize:11,color:"var(--muted)",fontWeight:600,letterSpacing:1,textTransform:"uppercase",marginBottom:10}}>Moedas</div>
        <div style={{display:"flex",gap:10,marginBottom:12}}>
          <button className={"cur-mode-btn"+(selecting==="base"?" active":"")}
            onClick={() => setSelecting(s => s==="base"?null:"base")} style={{flex:1}}>
            <div style={{fontSize:10,opacity:.7,marginBottom:2}}>BASE</div>
            <div style={{display:"flex",alignItems:"center",justifyContent:"center",gap:5}}>
              <span style={{fontSize:16}}>{CURRENCY_FLAGS[base]}</span><span style={{fontWeight:700}}>{base}</span>
            </div>
            <div style={{fontSize:10,color:"var(--muted)",marginTop:1}}>{CURRENCY_NAMES[base]}</div>
          </button>
          <div style={{display:"flex",alignItems:"center",color:"var(--muted)",fontSize:18}}>⇄</div>
          <button className={"cur-mode-btn"+(selecting==="conv"?" active":"")}
            onClick={() => setSelecting(s => s==="conv"?null:"conv")} style={{flex:1}}>
            <div style={{fontSize:10,opacity:.7,marginBottom:2}}>CONVERSÃO</div>
            <div style={{display:"flex",alignItems:"center",justifyContent:"center",gap:5}}>
              <span style={{fontSize:16}}>{CURRENCY_FLAGS[convCurrency]}</span><span style={{fontWeight:700}}>{convCurrency}</span>
            </div>
            <div style={{fontSize:10,color:"var(--muted)",marginTop:1}}>{CURRENCY_NAMES[convCurrency]}</div>
          </button>
        </div>
        {selecting && (
          <>
            <div style={{display:"grid",gridTemplateColumns:"repeat(4,1fr)",gap:8,marginBottom:6}}>
              {ALL_8.map(c => {
                const isB=base===c, isC=convCurrency===c;
                const isSel=selecting==="base"?isB:isC;
                const isOth=selecting==="base"?isC:isB;
                return (
                  <button key={c} disabled={isOth}
                    onClick={() => {
                      if(selecting==="base"){setBase(c);if(convCurrency===c)setConvCurrency(base);}
                      else{setConvCurrency(c);if(base===c)setBase(convCurrency);}
                      setSelecting(null);
                    }}
                    style={{padding:"10px 4px",borderRadius:12,border:"1.5px solid",
                      borderColor:isSel?"var(--accent)":"var(--border)",
                      background:isSel?"var(--accentT)":"var(--surf2)",
                      color:isSel?"var(--accent)":isOth?"var(--muted)":"var(--text)",
                      cursor:isOth?"not-allowed":"pointer",opacity:isOth?0.4:1,
                      display:"flex",flexDirection:"column",alignItems:"center",gap:3}}>
                    <span style={{fontSize:20}}>{CURRENCY_FLAGS[c]}</span>
                    <span style={{fontSize:11,fontWeight:700}}>{c}</span>
                  </button>
                );
              })}
            </div>
            <div style={{fontSize:11,color:"var(--muted)",textAlign:"center",marginBottom:4}}>
              Selecionando: <strong style={{color:"var(--accent)"}}>{selecting==="base"?"Moeda Base":"Conversão"}</strong>
            </div>
          </>
        )}
      </div>

      <div style={{marginBottom:24}}>
        <div style={{display:"flex",alignItems:"center",justifyContent:"space-between",marginBottom:10}}>
          <div>
            <div style={{fontSize:11,color:"var(--muted)",fontWeight:600,letterSpacing:1,textTransform:"uppercase"}}>Taxas</div>
            <div style={{fontSize:11,color:"var(--muted)",marginTop:2}}>1 moeda → {base}</div>
          </div>
          <button className="fetch-btn" onClick={fetchRates} disabled={fetchStatus==="loading"}>
            {fetchStatus==="loading"?<span className="spin">⟳</span>:"🌐"} Buscar
          </button>
        </div>
        <div style={{fontSize:12,color:fetchStatus==="ok"?"var(--green)":fetchStatus==="err"?"var(--red)":"var(--muted)",marginBottom:10,minHeight:18}}>
          {fetchStatus==="loading"&&<><span className="spin">⟳</span> </>}{fetchMsg||"Toque em Buscar para atualizar."}
        </div>
        {ALL_8.filter(c => c !== base).map(cur => {
          const val    = rates[cur] || 0;
          const isConv = cur === convCurrency;
          const dec    = ["JPY","PYG","ARS","CLP"].includes(cur) ? 4 : 2;
          return (
            <div className="cfg-rate-row" key={cur}
              style={{borderColor:isConv?"var(--accent)":undefined,background:isConv?"var(--accentT)":undefined}}>
              <div style={{fontSize:22}}>{CURRENCY_FLAGS[cur]}</div>
              <div style={{flex:1}}>
                <div style={{fontWeight:700,fontSize:13}}>
                  {cur}{isConv&&<span style={{fontSize:10,color:"var(--accent)",marginLeft:6}}>● conv</span>}
                </div>
                <div style={{fontSize:11,color:"var(--muted)"}}>{CURRENCY_NAMES[cur]}</div>
                <div style={{fontSize:11,color:"var(--muted)",marginTop:1}}>1 {cur} = {base} {val?val.toFixed(dec):"—"}</div>
              </div>
              <PriceInput className="cfg-rate-input" value={val||""} onChange={v=>setRates(r=>({...r,[cur]:v}))} placeholder={dec===4?"0,0000":"0,00"} />
            </div>
          );
        })}
      </div>
    </div>
  );
}

// ─── APP ─────────────────────────────────────────────────────────────────────
function App() {
  const [tab,          setTab]          = useState("dash");
  const [dark,         setDark]         = useState(true);
  const [products,     setProducts]     = useState(SEED_PRODUCTS);
  const [stores,       setStores]       = useState(SEED_STORES);
  const [base,         setBase]         = useState("BRL");
  const [convCurrency, setConvCurrency] = useState("USD");
  const [rates,        setRates]        = useState({USD:0,EUR:0,JPY:0,GBP:0,PYG:0,ARS:0,CLP:0});
  const scrollRef = useRef(null);
  const { toasts, add: addToast, dismiss } = useToasts();

  useEffect(() => { if (scrollRef.current) scrollRef.current.scrollTop = 0; }, [tab]);
  useEffect(() => {
    document.querySelector('meta[name="theme-color"]')?.setAttribute("content", dark?"#0e0e12":"#f5f5f8");
    document.body.style.background = dark?"#0e0e12":"#f5f5f8";
  }, [dark]);

  const nav = [
    { id:"dash",     ico:"🏠", label:"Início"    },
    { id:"products", ico:"📦", label:"Produtos"  },
    { id:"stores",   ico:"🏪", label:"Lojas"     },
    { id:"report",   ico:"📊", label:"Relatório" },
    { id:"conv",     ico:"💱", label:"Conversão" },
  ];

  return (
    <>
      <style>{buildStyles(dark)}</style>
      <div className="shell">
        <div className="topbar">
          <div className="topbar-title">Paraguai<span> Price</span></div>
          <div className="topbar-actions">
            <div className="icon-round" onClick={() => setTab("conv")}
              style={{fontSize:13,fontWeight:700,color:"var(--accent)",width:"auto",padding:"0 10px",borderRadius:20,cursor:"pointer"}}>
              {CURRENCY_FLAGS[base]} {base} → {CURRENCY_FLAGS[convCurrency]} {convCurrency}
            </div>
            <div className="icon-round" style={{width:36,cursor:"pointer"}} onClick={() => setDark(d=>!d)}>{dark?"☀️":"🌙"}</div>
          </div>
        </div>

        <ToastContainer toasts={toasts} dismiss={dismiss} />

        <div className="scroll" ref={scrollRef}>
          {tab==="dash"     && <Dashboard products={products} stores={stores} rates={rates} convCurrency={convCurrency} base={base} />}
          {tab==="products" && <Products  products={products} setProducts={setProducts} stores={stores} setStores={setStores} rates={rates} base={base} />}
          {tab==="stores"   && <StoresTab products={products} setProducts={setProducts} stores={stores} setStores={setStores} rates={rates} convCurrency={convCurrency} base={base} addToast={addToast} />}
          {tab==="report"   && <Report    products={products} stores={stores} rates={rates} convCurrency={convCurrency} base={base} />}
          {tab==="conv"     && <Config    rates={rates} setRates={setRates} convCurrency={convCurrency} setConvCurrency={setConvCurrency} base={base} setBase={setBase} />}
        </div>

        <div className="bnav">
          {nav.map(n => (
            <button key={n.id} className={"bnav-btn"+(tab===n.id?" on":"")} onClick={() => setTab(n.id)}>
              <span className="ico">{n.ico}</span>{n.label}
            </button>
          ))}
        </div>
      </div>
    </>
  );
}

ReactDOM.createRoot(document.getElementById("root")).render(<App />);
</script>
</body>
</html>
