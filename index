  `;
}

// ─── STORE HELPERS ────────────────────────────────────────────────────────────
function storeFlag(store) { return CURRENCY_FLAGS[store?.currency] || "🏪"; }
function storeLabel(store) { return store ? `${storeFlag(store)} ${store.name}` : "—"; }

// ─── TOAST ───────────────────────────────────────────────────────────────────
function useToasts() {
  const [toasts, setToasts] = useState([]);
  function add(t) {
    const id = uid();
    setToasts(p => [...p, { id, ...t }]);
    setTimeout(() => setToasts(p => p.filter(x => x.id !== id)), 4500);
  }
  function dismiss(id) { setToasts(p => p.filter(x => x.id !== id)); }
  return { toasts, add, dismiss };
}
function ToastContainer({ toasts, dismiss }) {
  return (
    <div className="toast-wrap">
      {toasts.map(t => (
        <div key={t.id} className={`toast ${t.type==="warn"?"toast-warn":t.type==="ok"?"toast-ok":""}`}
