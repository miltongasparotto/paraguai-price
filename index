<div id="root"></div>
<script type="text/babel">
const { useState, useMemo, useRef, useEffect } = React;

// ─── CONSTANTS ───────────────────────────────────────────────────────────────
const CURRENCIES       = ["BRL","USD","EUR","JPY","GBP","PYG","ARS","CLP"];
const CURRENCY_SYMBOLS = { BRL:"R$",USD:"$",EUR:"€",JPY:"¥",GBP:"£",PYG:"₲",ARS:"$",CLP:"$" };
const CURRENCY_FLAGS   = { BRL:"🇧🇷",USD:"🇺🇸",EUR:"🇪🇺",JPY:"🇯🇵",GBP:"🇬🇧",PYG:"🇵🇾",ARS:"🇦🇷",CLP:"🇨🇱" };
const CURRENCY_NAMES   = { BRL:"Real Brasileiro",USD:"Dólar Americano",EUR:"Euro",JPY:"Iene Japonês",GBP:"Libra Esterlina",PYG:"Guarani Paraguaio",ARS:"Peso Argentino",CLP:"Peso Chileno" };
const ROUND_CURRENCIES = new Set(["JPY","PYG","ARS","CLP"]);

// ─── SEED DATA ───────────────────────────────────────────────────────────────
// Stores now have currency instead of country
const SEED_STORES = [
  { id:"st1", name:"Amazon BR",     currency:"BRL" },
  { id:"st2", name:"Mercado Livre", currency:"BRL" },
  { id:"st3", name:"Amazon US",     currency:"USD" },
  { id:"st4", name:"Best Buy",      currency:"USD" },
];

// Products: variants:null means "simple" (no variant mode), variants:[] means variant mode
const SEED_PRODUCTS = [
  { id:"pr1", name:"SSD Samsung 870 EVO", category:"Armazenamento",
    hasVariants: true,
    variants:[
      { id:"v1", label:"500GB", favorite:"e2",
        prices:[
          { id:"e1", storeId:"st1", amount:349,   currency:"BRL", link:"" },
          { id:"e2", storeId:"st3", amount:54.99,  currency:"USD", link:"https://amazon.com" },
        ]},
      { id:"v2", label:"1TB", favorite:null,
        prices:[
          { id:"e3", storeId:"st1", amount:599,   currency:"BRL", link:"" },
          { id:"e4", storeId:"st3", amount:89.99,  currency:"USD", link:"https://amazon.com" },
        ]},
    ]},
  { id:"pr2", name:"AirPods Pro 2", category:"Áudio",
    hasVariants: false,
    prices:[
      { id:"e5", storeId:"st1", amount:2299,   currency:"BRL", link:"" },
      { id:"e6", storeId:"st3", amount:189.99,  currency:"USD", link:"https://amazon.com" },
    ],
    favorite:"e6",
  },
];

// ─── UTILS ───────────────────────────────────────────────────────────────────
function uid() { return Math.random().toString(36).slice(2,9); }

function toBase(amount, currency, rates, base) {
  if (currency === base) return amount;
  const r = rates[currency];
  if (!r) return 0;
  return amount * r;
}
function fromBase(baseAmt, currency, rates, base) {
  if (currency === base) return baseAmt;
  const r = rates[currency];
  if (!r) return 0;
  return baseAmt / r;
}

function fmtAmt(v, currency) {
  const s = CURRENCY_SYMBOLS[currency] || currency;
  if (!v && v !== 0) return s + "\u00a0—";
  if (ROUND_CURRENCIES.has(currency)) return s + "\u00a0" + Math.round(v).toLocaleString("pt-BR");
  const [int, dec] = v.toFixed(2).split(".");
  return s + "\u00a0" + int.replace(/\B(?=(\d{3})+(?!\d))/g, ".") + "," + dec;
}

function fmtInput(v) {
  if (!v) return "";
  const [int, dec] = parseFloat(v).toFixed(2).split(".");
  return int.replace(/\B(?=(\d{3})+(?!\d))/g, ".") + "," + dec;
}
function parseInput(str) {
  const cleaned = String(str || "").replace(/\./g, "").replace(",", ".");
  const v = parseFloat(cleaned);
  return isNaN(v) ? 0 : v;
}

function cheapestEntry(prices, rates, base) {
  if (!prices || !prices.length) return null;
  return prices.reduce((best, e) =>
    toBase(e.amount, e.currency, rates, base) < toBase(best.amount, best.currency, rates, base) ? e : best
  , prices[0]);
}

// Get all "price rows" from a product (unified simple/variant)
function getPriceRows(prod) {
  if (!prod.hasVariants) return [{ key: prod.id, label: null, prices: prod.prices || [], favorite: prod.favorite, isSimple: true }];
  return (prod.variants || []).map(v => ({ key: v.id, label: v.label, prices: v.prices, favorite: v.favorite, isSimple: false, variantId: v.id }));
}

// ─── PRICE INPUT ─────────────────────────────────────────────────────────────
function PriceInput({ value, onChange, className, placeholder }) {
  const [raw, setRaw] = useState(() => value ? fmtInput(value) : "");

  useEffect(() => {
    if (!value) { setRaw(""); return; }
    if (parseInput(raw) !== value) setRaw(fmtInput(value));
  }, [value]);

  function handleChange(e) {
    let v = e.target.value.replace(/[^0-9,]/g, "");
    setRaw(v);
    onChange(parseInput(v));
  }
  function handleBlur() {
    const n = parseInput(raw);
    setRaw(n > 0 ? fmtInput(n) : "");
  }

  return (
    <input className={className} inputMode="decimal"
      placeholder={placeholder || "0,00"} value={raw}
      onChange={handleChange} onBlur={handleBlur} />
  );
}

