      {showEditStore && (
        <Sheet title="Editar Loja" onClose={() => setShowEditStore(null)}
          footer={<>
            <button className="btn btn-d" style={{flex:"none",padding:"14px 16px"}} onClick={() => { delStore(showEditStore.id); setShowEditStore(null); }}>🗑</button>
            <button className="btn btn-s" onClick={() => setShowEditStore(null)}>Cancelar</button>
            <button className="btn btn-p" onClick={() => saveStore(showEditStore)}>Salvar</button>
