// ─── CALCULATOR ──────────────────────────────────────────────────────────────
function Calculator({ rates, convCurrency, base, onClose }) {
  const [display, setDisplay] = useState("0");
  const [expr, setExpr]       = useState("");
  const [mode, setMode]       = useState("toBRL");
  const rate = rates[convCurrency] || 0;
  function press(k) {
    if (k==="AC"){setExpr("");setDisplay("0");return}
    if (k==="⌫"){setDisplay(d=>d.slice(0,-1)||"0");return}
    if (k==="="){
      try{
        const safe=display.replace(/×/g,"*").replace(/÷/g,"/").replace(/[^0-9+\-*/().]/g,"");
        const r=Function('"use strict";return('+safe+')')();
        setExpr(display+" =");
        setDisplay(isFinite(r)?String(parseFloat(r.toFixed(6))):"Erro");
      }catch{setDisplay("Erro")}
      return;
    }
    if(["+","-","×","÷"].includes(k)){setDisplay(d=>(d==="0"||d==="Erro")?k:d+k);return}
    if(k==="."){const p=display.split(/[+\-×÷]/);if(p[p.length-1].includes("."))return}
    setDisplay(d=>(d==="0"||d==="Erro")?k:d+k);
  }
  const num=parseFloat(display)||0;
  const converted=!rate?"— (configure a taxa)":mode==="toBRL"?fmtAmt(num*rate,base):fmtAmt(num/rate,convCurrency);
  const keys=[
    {k:"AC",cls:"del"},{k:"⌫",cls:"del"},{k:"÷",cls:"op"},{k:"×",cls:"op"},
    {k:"7"},{k:"8"},{k:"9"},{k:"-",cls:"op"},
    {k:"4"},{k:"5"},{k:"6"},{k:"+",cls:"op"},
    {k:"1"},{k:"2"},{k:"3"},{k:"=",cls:"eq"},
    {k:"0",cls:"zero"},{k:"."},
  ];
  return (
    <Sheet title={`Calculadora · ${CURRENCY_FLAGS[convCurrency]} ${convCurrency}`} onClose={onClose}>
      <div style={{display:"flex",gap:8,marginBottom:14}}>
        <button className={`btn ${mode==="toBRL"?"btn-p":"btn-s"}`} style={{fontSize:13,padding:"10px 0"}} onClick={()=>setMode("toBRL")}>{convCurrency} → {base}</button>
        <button className={`btn ${mode==="fromBRL"?"btn-p":"btn-s"}`} style={{fontSize:13,padding:"10px 0"}} onClick={()=>setMode("fromBRL")}>{base} → {convCurrency}</button>
      </div>
      <div style={{background:"var(--surf2)",border:"1px solid var(--border)",borderRadius:14,padding:16,marginBottom:14,textAlign:"right"}}>
        <div style={{fontSize:12,color:"var(--muted)",minHeight:18}}>{expr}</div>
        <div style={{fontSize:34,fontWeight:700,letterSpacing:-1,marginTop:4}}>{display}</div>
        <div style={{fontSize:14,color:"var(--green)",marginTop:6,fontWeight:600}}>= {converted}</div>
      </div>
      <div className="calc-grid">
        {keys.map(({k,cls=""},i)=>(
          <button key={i} className={`ck ${cls}`} onClick={()=>press(k)}>{k}</button>
        ))}
      </div>
    </Sheet>
  );
}

