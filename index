  return (
    <div>
      <div style={{padding:"16px 16px 10px"}}>
        <div className="sec-hd">
          <div className="sec-title">Lojas</div>
          <div className="sec-sub">{stores.length} {stores.length===1?"loja":"lojas"}</div>
        </div>
      </div>

      {stores.length === 0 && <div className="empty"><div className="empty-ico">🏪</div><div className="empty-t">Nenhuma loja</div><div className="empty-s">Toque em + para adicionar</div></div>}

      <div className="store-list">
        {stores.map(st => {
          const isExp  = expandedStore === st.id;
          const items  = getStoreItems(st.id);
          return (
            <div className="store-card" key={st.id}>
              <div className="store-card-head" onClick={() => setExpandedStore(isExp ? null : st.id)}>
                <div className="store-card-flag">{storeFlag(st)}</div>
                <div className="store-card-info">
                  <div className="store-card-name">{st.name}</div>
                  <div className="store-card-sub">{st.currency} · {items.length} {items.length===1?"produto":"produtos"}</div>
                </div>
                <div onClick={e => e.stopPropagation()} style={{display:"flex",gap:2}}>
                  <button className="icon-btn" style={{padding:"4px 6px"}} onClick={() => setShowEditStore({...st})}>✏️</button>
                  <button className="icon-btn" style={{padding:"4px 6px",color:"var(--red)"}} onClick={() => delStore(st.id)}>🗑</button>
                </div>
                <span className={"chevron"+(isExp?" open":"")} style={{marginLeft:2}}>▾</span>
              </div>

              {isExp && (
                <div className="store-products-wrap">
                  {items.length === 0 ? (
                    <div className="store-empty">Nenhum produto cadastrado</div>
                  ) : items.map(({ prod, variant, entry }) => {
                    const brl = toBase(entry.amount, entry.currency, rates, base);
                    const showSec = entry.currency !== base && brl > 0;
                    return (
                      <div className="store-product-item" key={entry.id}>
                        <div style={{display:"flex",alignItems:"flex-start",justifyContent:"space-between"}}>
                          <div style={{display:"flex",alignItems:"center",gap:8}}>
                            {prod.photo && <img src={prod.photo} alt="" style={{width:28,height:28,borderRadius:6,objectFit:"cover",flexShrink:0}} />}
                            <div>
                              <div className="spi-name">{prod.name}</div>
                              {variant && <div style={{fontSize:12,color:"var(--muted)",marginTop:2}}>⎇ {variant.label}</div>}
                            </div>
                          </div>
                          <button className="icon-btn" onClick={() => delStoreEntry(prod, variant, entry.id)}>🗑</button>
                        </div>
                        <div style={{marginTop:8}}>
                          <div style={{fontSize:17,fontWeight:700,color:"var(--green)"}}>{brl>0?fmtAmt(brl,base):"— taxa não conf."}</div>
                          {showSec && <div style={{fontSize:12,color:"var(--muted)"}}>{fmtAmt(entry.amount, entry.currency)}</div>}
                          {entry.link && <a href={entry.link} target="_blank" rel="noopener noreferrer" className="spi-link">↗ Ver link</a>}
                        </div>
                      </div>
                    );
                  })}
                  <div className="add-to-store-btn" onClick={() => openAdd(st.id)}>
                    <span style={{fontSize:16}}>＋</span> Adicionar produto
                  </div>
                </div>
              )}
            </div>
          );
        })}
      </div>

      <button className="fab" onClick={() => setShowAddStore(true)}>＋</button>

      {/* ADD STORE */}
      {showAddStore && (
        <Sheet title="Nova Loja" onClose={() => setShowAddStore(false)}
          footer={<><button className="btn btn-s" onClick={() => setShowAddStore(false)}>Cancelar</button><button className="btn btn-p" onClick={addStore}>Adicionar</button></>}>
          <div className="fg"><label className="fl">Nome</label><input className="fi" placeholder="Ex: Amazon US, Best Buy..." value={newStore.name} onChange={e=>setNewStore(s=>({...s,name:e.target.value}))} autoFocus /></div>
          <div className="fg">
            <label className="fl">Moeda da loja</label>
            <select className="fs" value={newStore.currency} onChange={e=>setNewStore(s=>({...s,currency:e.target.value}))}>
              {CURRENCIES.map(c => <option key={c} value={c}>{CURRENCY_FLAGS[c]} {c} — {CURRENCY_NAMES[c]}</option>)}
