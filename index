          {(apMode === "new" || (apMode === "existing" && apProd)) && (
            <div style={{borderTop:"1px solid var(--border)",paddingTop:14}}>
              <div style={{fontSize:11,color:"var(--muted)",fontWeight:600,letterSpacing:0.8,textTransform:"uppercase",marginBottom:10}}>Preço nessa loja</div>
              <div className="fr" style={{marginBottom:8}}>
                <div className="fg">
                  <label className="fl">Valor</label>
                  <PriceInput className="fi" value={apEntry.amount} onChange={v=>setApEntry(p=>({...p,amount:v}))} />
                </div>
                <div className="fg">
                  <label className="fl">Moeda</label>
                  <select className="fs" value={apEntry.currency} onChange={e=>setApEntry(p=>({...p,currency:e.target.value}))}>
                    {CURRENCIES.map(c => <option key={c} value={c}>{CURRENCY_FLAGS[c]} {c}</option>)}
                  </select>
                </div>
              </div>
              <ConvPreview amount={apEntry.amount} currency={apEntry.currency} rates={rates} base={base} />
              <div className="fg" style={{marginTop:8}}>
                <label className="fl">Link de compra (opcional)</label>
                <input className="fi" type="url" inputMode="url" placeholder="https://..." value={apEntry.link} onChange={e=>setApEntry(p=>({...p,link:e.target.value}))} />
              </div>
