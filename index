function Products({ products, setProducts, stores, setStores, rates, base }) {
  const [expanded,      setExpanded]      = useState(null);
  const [expandedV,     setExpandedV]     = useState({});
  const [showAddProd,   setShowAddProd]   = useState(false);
  const [showEditProd,  setShowEditProd]  = useState(null);
  const [showAddVar,    setShowAddVar]    = useState(null);
  const [showEditVar,   setShowEditVar]   = useState(null);
  const [showAddEntry,  setShowAddEntry]  = useState(null);
  const [showEditEntry, setShowEditEntry] = useState(null);
  const [showCamera,    setShowCamera]    = useState(null); // {prodId, onSave}

  // New product form
  const emptyEntry = () => ({ storeId:"", amount:0, currency:base, link:"" });
  const [np, setNp] = useState({ name:"", category:"", hasVariants:false, variantLabel:"" });
  const [npEntry, setNpEntry] = useState(() => ({ storeId:"", amount:0, currency:base, link:"" }));
  const [newVar,    setNewVar]    = useState({ label:"" });
  const [newEntry,  setNewEntry]  = useState(() => ({ storeId:"", amount:0, currency:base, link:"" }));

  // ── product mutations ──
  function addProd() {
    if (!np.name.trim()) return;
    if (np.hasVariants) {
      // Create with variant mode, no prices yet — user adds via the UI
      setProducts(p => [...p, { id:uid(), name:np.name.trim(), category:np.category.trim(), hasVariants:true, variants:[] }]);
    } else {
      // Simple product — if entry filled, add it
      const prices = (npEntry.storeId && npEntry.amount) ? [{ id:uid(), ...npEntry }] : [];
      setProducts(p => [...p, { id:uid(), name:np.name.trim(), category:np.category.trim(), hasVariants:false, prices, favorite:null }]);
    }
    setNp({ name:"", category:"", hasVariants:false, variantLabel:"" });
    setNpEntry(emptyEntry());
    setShowAddProd(false);
  }
  function saveProd(prod) {
    setProducts(p => p.map(pr => {
      if (pr.id !== prod.id) return pr;
      const base = { ...pr, name:prod.name.trim(), category:prod.category.trim() };
      // If converting from simple → variant mode
      if (!pr.hasVariants && prod.hasVariants) {
        const varLabel = prod.convertVariantLabel?.trim() || "Padrão";
        return {
          ...base,
          hasVariants: true,
          variants: [{ id:uid(), label:varLabel, prices:pr.prices||[], favorite:pr.favorite||null }],
          prices: undefined,
          favorite: undefined,
        };
      }
      return base;
    }));
    setShowEditProd(null);
  }
  function delProd(id) {
    setProducts(p => p.filter(pr => pr.id !== id));
    if (expanded === id) setExpanded(null);
    setShowEditProd(null);
  }

  // ── variant mutations ──
  function addVar(prodId) {
    if (!newVar.label.trim()) return;
    setProducts(p => p.map(pr => pr.id !== prodId ? pr : { ...pr, variants:[...pr.variants, { id:uid(), label:newVar.label.trim(), prices:[], favorite:null }] }));
    setNewVar({ label:"" }); setShowAddVar(null);
  }
  function saveVar(prodId, varId, label) {
    setProducts(p => p.map(pr => pr.id !== prodId ? pr : { ...pr, variants:pr.variants.map(v => v.id !== varId ? v : {...v, label:label.trim()}) }));
    setShowEditVar(null);
  }
  function delVar(prodId, varId) {
    setProducts(p => p.map(pr => pr.id !== prodId ? pr : { ...pr, variants:pr.variants.filter(v => v.id !== varId) }));
    setShowEditVar(null);
  }

  // ── entry mutations (works for both simple and variant) ──
  function addEntry(ctx) {
    if (!newEntry.storeId || !newEntry.amount) return;
    const e = { id:uid(), ...newEntry };
    if (ctx.variantId) {
      setProducts(p => p.map(pr => pr.id !== ctx.prodId ? pr : { ...pr,
        variants: pr.variants.map(v => v.id !== ctx.variantId ? v : { ...v, prices:[...v.prices,e] })
      }));
    } else {
      setProducts(p => p.map(pr => pr.id !== ctx.prodId ? pr : { ...pr, prices:[...(pr.prices||[]),e] }));
    }
    setNewEntry(emptyEntry()); setShowAddEntry(null);
  }
  function saveEntry(ctx, entry) {
    if (ctx.variantId) {
      setProducts(p => p.map(pr => pr.id !== ctx.prodId ? pr : { ...pr,
        variants: pr.variants.map(v => v.id !== ctx.variantId ? v : { ...v, prices:v.prices.map(e => e.id !== entry.id ? e : entry) })
      }));
    } else {
      setProducts(p => p.map(pr => pr.id !== ctx.prodId ? pr : { ...pr, prices:(pr.prices||[]).map(e => e.id !== entry.id ? e : entry) }));
    }
    setShowEditEntry(null);
  }
  function delEntry(ctx, entryId) {
    if (ctx.variantId) {
      setProducts(p => p.map(pr => pr.id !== ctx.prodId ? pr : { ...pr,
        variants: pr.variants.map(v => v.id !== ctx.variantId ? v : { ...v,
          prices: v.prices.filter(e => e.id !== entryId),
          favorite: v.favorite === entryId ? null : v.favorite
        })
      }));
    } else {
      setProducts(p => p.map(pr => pr.id !== ctx.prodId ? pr : { ...pr,
        prices: (pr.prices||[]).filter(e => e.id !== entryId),
        favorite: pr.favorite === entryId ? null : pr.favorite
      }));
    }
  }
  function toggleFav(ctx, entryId) {
    if (ctx.variantId) {
      setProducts(p => p.map(pr => pr.id !== ctx.prodId ? pr : { ...pr,
        variants: pr.variants.map(v => v.id !== ctx.variantId ? v : { ...v, favorite: v.favorite===entryId?null:entryId })
      }));
    } else {
      setProducts(p => p.map(pr => pr.id !== ctx.prodId ? pr : { ...pr, favorite: pr.favorite===entryId?null:entryId }));
    }
  }

  // ── render price list ──
  function renderPriceList(prices, fav, ctx) {
    const cheap = cheapestEntry(prices, rates, base);
    return (
      <div className="prices-wrap">
        {prices.map(e => {
          const store   = stores.find(s => s.id === e.storeId);
          const isCheap = cheap?.id === e.id && prices.length > 1;
          const isFav   = fav === e.id;
          return (
            <div className="price-entry" key={e.id}>
              <div className="pe-left">
                <div className="pe-store">
                  <span>{storeFlag(store)}</span>
                  <span>{store?.name || "—"}</span>
                  {isCheap && <span className="tag-cheap">✓ Menor</span>}
                </div>
                <div style={{marginTop:3}}>
                  <PriceDisplay entry={e} rates={rates} base={base} isCheap={isCheap} isFav={isFav} />
                </div>
                {e.link && (
                  <a href={e.link} target="_blank" rel="noopener noreferrer"
                    style={{fontSize:11,color:"var(--accent)",marginTop:2,display:"block",textDecoration:"none"}}>↗ Ver produto</a>
                )}
              </div>
              <div className="pe-right">
                <button className="tag-fav-btn" onClick={() => toggleFav(ctx, e.id)}>{isFav?"★":"☆"}</button>
                <button className="icon-btn" onClick={() => { setShowEditEntry({ ctx, entry:{...e} }); }}>✏️</button>
                <button className="icon-btn" onClick={() => delEntry(ctx, e.id)}>🗑</button>
              </div>
            </div>
          );
        })}
        <div className="add-price-btn" onClick={() => { setNewEntry(emptyEntry()); setShowAddEntry(ctx); }}>
          <span style={{fontSize:16}}>＋</span> Adicionar loja / preço
        </div>
      </div>
    );
  }

  return (
    <div className="page">
      <div className="sec-hd">
        <div className="sec-title">Produtos</div>
        <div className="sec-sub">{products.length} {products.length===1?"item":"itens"}</div>
      </div>

      {products.length === 0 && (
        <div className="empty"><div className="empty-ico">📦</div><div className="empty-t">Nenhum produto</div><div className="empty-s">Toque em + para adicionar</div></div>
      )}

      {products.map(prod => {
        const isExp = expanded === prod.id;
        // Summary: cheapest across all prices/variants
        const allPrices = prod.hasVariants
          ? (prod.variants||[]).flatMap(v => v.prices)
          : (prod.prices||[]);
        const cheapAll = cheapestEntry(allPrices, rates, base);
        const cheapBRL = cheapAll ? toBase(cheapAll.amount, cheapAll.currency, rates, base) : null;

        return (
          <div className="prod-card" key={prod.id}>
            <div className="prod-head" onClick={() => setExpanded(isExp ? null : prod.id)}>
              <div style={{flex:1,minWidth:0}}>
                <div style={{display:"flex",alignItems:"center",gap:6}}>
                  {prod.photo && <img src={prod.photo} alt="" style={{width:32,height:32,borderRadius:8,objectFit:"cover",flexShrink:0}} />}
                  <div className="prod-name">{prod.name}</div>
                  <span style={{fontSize:10,background:prod.hasVariants?"var(--orangeT)":"var(--accentT)",color:prod.hasVariants?"var(--orange)":"var(--accent)",padding:"2px 7px",borderRadius:10,fontWeight:700,flexShrink:0}}>
                    {prod.hasVariants ? "⎇ vars" : "simples"}
                  </span>
                </div>
                {prod.category && <div className="prod-cat">{prod.category}</div>}
              </div>
              {cheapBRL !== null && (
                <div style={{fontSize:13,fontWeight:700,color:"var(--green)",flexShrink:0,marginRight:4}}>{fmtAmt(cheapBRL,base)}</div>
              )}
              <div onClick={e => { e.stopPropagation(); setShowEditProd({...prod,_converting:false,_origPrices:prod.prices||[]}); }} style={{padding:"4px 6px",color:"var(--muted)",fontSize:14,cursor:"pointer"}}>✏️</div>
              <span className={"chevron"+(isExp?" open":"")}>▾</span>
            </div>

            {isExp && (
              prod.hasVariants ? (
                // ── VARIANT MODE ──
                <div className="variants-wrap">
                  {(prod.variants||[]).map(v => {
                    const vExp = !!expandedV[v.id];
                    const cheap = cheapestEntry(v.prices, rates, base);
                    const cheapBRL = cheap ? toBase(cheap.amount, cheap.currency, rates, base) : null;
                    const fav = v.favorite ? v.prices.find(e => e.id === v.favorite) : null;
                    const favIsExp = !!(fav && cheap && fav.id !== cheap.id);
                    const displayEntry = fav || cheap;
                    const displayBRL = displayEntry ? toBase(displayEntry.amount, displayEntry.currency, rates, base) : null;

                    return (
                      <div className="variant-row" key={v.id}>
                        <div className="variant-head" onClick={() => setExpandedV(s => ({...s,[v.id]:!s[v.id]}))}>
                          <div style={{fontSize:13}}>⎇</div>
                          <div className="variant-label">{v.label}</div>
                          {displayBRL !== null && (
                            <div style={{fontSize:13,fontWeight:700,color:fav?"var(--gold)":"var(--green)"}}>
                              {fmtAmt(displayBRL, base)}
                              {favIsExp && <span style={{fontSize:10,fontWeight:400,color:"var(--muted)",marginLeft:4}}>★</span>}
                            </div>
                          )}
                          <div style={{fontSize:11,color:"var(--muted)"}}>{v.prices.length}lj</div>
                          <div onClick={e => { e.stopPropagation(); setShowEditVar({prodId:prod.id,variant:{...v}}); }} style={{padding:"2px 5px",color:"var(--muted)",fontSize:13,cursor:"pointer"}}>✏️</div>
                          <span className={"vcaret"+(vExp?" open":"")}>▾</span>
                        </div>
                        {vExp && renderPriceList(v.prices, v.favorite, { prodId:prod.id, variantId:v.id })}
                      </div>
                    );
                  })}

                  {/* Add variant — distinct orange style */}
                  <div className="add-variant-btn" onClick={() => { setNewVar({label:""}); setShowAddVar(prod.id); }}>
                    <div className="av-ico">⎇</div>
                    Nova variação
                  </div>

                  <div style={{padding:"10px 14px",display:"flex",justifyContent:"flex-end"}}>
                    <span style={{fontSize:12,color:"var(--red)",cursor:"pointer"}} onClick={() => delProd(prod.id)}>🗑 Remover produto</span>
                  </div>
                </div>
              ) : (
                // ── SIMPLE MODE ──
                <div className="variants-wrap">
                  {renderPriceList(prod.prices||[], prod.favorite, { prodId:prod.id, variantId:null })}
                  <div style={{padding:"10px 14px",display:"flex",justifyContent:"flex-end"}}>
                    <span style={{fontSize:12,color:"var(--red)",cursor:"pointer"}} onClick={() => delProd(prod.id)}>🗑 Remover produto</span>
                  </div>
                </div>
              )
            )}
          </div>
        );
      })}

      <button className="fab" onClick={() => { setNp({name:"",category:"",hasVariants:false}); setNpEntry(emptyEntry()); setShowAddProd(true); }}>＋</button>

      {/* ── ADD PRODUCT ── */}
      {showAddProd && (
        <Sheet title="Novo Produto" onClose={() => setShowAddProd(false)}
          footer={<><button className="btn btn-s" onClick={() => setShowAddProd(false)}>Cancelar</button><button className="btn btn-p" onClick={addProd} disabled={!np.name.trim()} style={{opacity:np.name.trim()?1:.5}}>Adicionar</button></>}>
          <div className="fg"><label className="fl">Nome</label><input className="fi" placeholder="Ex: iPhone 16 Pro" value={np.name} onChange={e=>setNp(p=>({...p,name:e.target.value}))} autoFocus /></div>
          <div className="fg"><label className="fl">Categoria (opcional)</label><input className="fi" placeholder="Ex: Smartphones" value={np.category} onChange={e=>setNp(p=>({...p,category:e.target.value}))} /></div>

          {/* Type toggle */}
          <div className="fg">
            <label className="fl">Tipo</label>
            <div className="radio-group">
              <button className={`radio-opt ${!np.hasVariants?"on":""}`} onClick={() => setNp(p=>({...p,hasVariants:false}))}>
                📦 Produto simples
              </button>
              <button className={`radio-opt ${np.hasVariants?"on":""}`} onClick={() => setNp(p=>({...p,hasVariants:true}))}>
                ⎇ Com variações
              </button>
            </div>
          </div>

          {!np.hasVariants ? (
            <>
              <div className="section-divider">Preço inicial (opcional)</div>
              <PriceFields entry={npEntry} onChange={setNpEntry} stores={stores} setStores={setStores} rates={rates} base={base} />
            </>
          ) : (
            <div style={{background:"var(--orangeT)",border:"1px solid var(--orange)",borderRadius:12,padding:"12px 14px"}}>
              <div style={{fontSize:13,color:"var(--orange)",fontWeight:600}}>⎇ Modo variações ativo</div>
              <div style={{fontSize:12,color:"var(--muted)",marginTop:4}}>Após criar o produto, adicione variações e preços por dentro dele.</div>
            </div>
          )}
        </Sheet>
      )}

      {/* ── EDIT PRODUCT ── */}
      {showEditProd && (
        <Sheet title="Editar Produto" onClose={() => setShowEditProd(null)}
          footer={<>
            <button className="btn btn-d" style={{flex:"none",padding:"14px 16px"}} onClick={() => delProd(showEditProd.id)}>🗑</button>
            <button className="btn btn-s" onClick={() => setShowEditProd(null)}>Cancelar</button>
            <button className="btn btn-p" onClick={() => saveProd(showEditProd)}>Salvar</button>
          </>}>
          <div className="fg"><label className="fl">Nome</label><input className="fi" value={showEditProd.name} onChange={e=>setShowEditProd(p=>({...p,name:e.target.value}))} autoFocus /></div>
          <div className="fg"><label className="fl">Categoria</label><input className="fi" value={showEditProd.category} onChange={e=>setShowEditProd(p=>({...p,category:e.target.value}))} /></div>

          {/* Photo picker */}
          <div className="fg">
            <label className="fl">Foto do produto (opcional)</label>
            <div style={{display:"flex",gap:8}}>
              <button type="button" className="btn btn-s" style={{flex:1,fontSize:13,padding:"10px 0"}}
                onClick={() => { setShowCamera({prodId:showEditProd.id, onSave:(url)=>setShowEditProd(p=>({...p,photo:url}))}); }}>
                📷 Câmera
              </button>
              <label className="btn btn-s" style={{flex:1,fontSize:13,padding:"10px 0",cursor:"pointer",justifyContent:"center",display:"flex",alignItems:"center",gap:6}}>
                🖼 Galeria
                <input type="file" accept="image/*" style={{display:"none"}} onChange={e=>{
                  const f=e.target.files[0];
                  if(!f)return;
                  const reader=new FileReader();
                  reader.onload=(ev)=>setShowEditProd(p=>({...p,photo:ev.target.result}));
                  reader.readAsDataURL(f);
                }} />
              </label>
            </div>
            {showEditProd.photo && (
              <div style={{position:"relative",marginTop:4}}>
                <img src={showEditProd.photo} alt="" style={{width:"100%",borderRadius:10,maxHeight:160,objectFit:"cover"}} />
                <button onClick={()=>setShowEditProd(p=>({...p,photo:null}))}
                  style={{position:"absolute",top:6,right:6,background:"rgba(0,0,0,.6)",border:"none",borderRadius:"50%",
                    width:26,height:26,color:"#fff",cursor:"pointer",fontSize:14,display:"flex",alignItems:"center",justifyContent:"center"}}>×</button>
              </div>
            )}
          </div>

          {/* Type info / conversion */}
          {showEditProd.hasVariants ? (
            <div style={{background:"var(--orangeT)",border:"1px solid var(--orange)",borderRadius:12,padding:"12px 14px"}}>
              <div style={{fontSize:13,color:"var(--orange)",fontWeight:600}}>⎇ Produto com variações</div>
              <div style={{fontSize:12,color:"var(--muted)",marginTop:4}}>Adicione novas variações abrindo o produto na lista.</div>
            </div>
          ) : (
            <>
              <div style={{background:"var(--surf2)",borderRadius:12,padding:"12px 14px",border:"1px solid var(--border)"}}>
                <div style={{fontSize:13,fontWeight:600,marginBottom:4}}>📦 Produto simples</div>
                <div style={{fontSize:12,color:"var(--muted)"}}>Converter para modo de variações?</div>
                {!showEditProd.hasVariants && !showEditProd._converting && (
                  <button type="button"
                    style={{marginTop:8,padding:"7px 14px",borderRadius:8,background:"var(--orangeT)",border:"1px solid var(--orange)",
                      color:"var(--orange)",fontSize:12,fontWeight:600,cursor:"pointer"}}
                    onClick={()=>setShowEditProd(p=>({...p,_converting:true,hasVariants:true,convertVariantLabel:"Padrão"}))}>
                    ⎇ Converter para variações
                  </button>
                )}
              </div>
              {showEditProd._converting && (
                <div style={{background:"var(--orangeT)",border:"1px solid var(--orange)",borderRadius:12,padding:"12px 14px"}}>
                  <div style={{fontSize:13,color:"var(--orange)",fontWeight:600,marginBottom:8}}>⎇ Conversão para variações</div>
                  <div className="fg">
                    <label className="fl">Nome da primeira variação</label>
                    <input className="fi" placeholder="Ex: Padrão, 128GB, Preto..."
                      value={showEditProd.convertVariantLabel||""}
                      onChange={e=>setShowEditProd(p=>({...p,convertVariantLabel:e.target.value}))} />
                  </div>
                  <div style={{fontSize:11,color:"var(--muted)",marginTop:8}}>
                    Os {(showEditProd._origPrices||[]).length} preços cadastrados serão movidos para essa variação.
                  </div>
                  <button type="button"
                    style={{marginTop:8,padding:"6px 12px",borderRadius:8,background:"var(--surf2)",border:"1px solid var(--border)",
                      color:"var(--muted)",fontSize:12,cursor:"pointer"}}
                    onClick={()=>setShowEditProd(p=>({...p,_converting:false,hasVariants:false,convertVariantLabel:""}))}>
                    Cancelar conversão
                  </button>
                </div>
              )}
            </>
          )}
        </Sheet>
      )}

      {/* ── ADD VARIANT ── */}
      {showAddVar && (
        <Sheet title="Nova Variação" onClose={() => setShowAddVar(null)}
          footer={<><button className="btn btn-s" onClick={() => setShowAddVar(null)}>Cancelar</button><button className="btn btn-p" onClick={() => addVar(showAddVar)}>Adicionar</button></>}>
          <div className="fg"><label className="fl">Descrição</label><input className="fi" placeholder="Ex: 500GB, 1TB, Azul..." value={newVar.label} onChange={e=>setNewVar({label:e.target.value})} autoFocus /></div>
        </Sheet>
      )}

      {/* ── EDIT VARIANT ── */}
      {showEditVar && (
        <Sheet title="Editar Variação" onClose={() => setShowEditVar(null)}
          footer={<>
            <button className="btn btn-d" style={{flex:"none",padding:"14px 16px"}} onClick={() => delVar(showEditVar.prodId, showEditVar.variant.id)}>🗑</button>
            <button className="btn btn-s" onClick={() => setShowEditVar(null)}>Cancelar</button>
            <button className="btn btn-p" onClick={() => saveVar(showEditVar.prodId, showEditVar.variant.id, showEditVar.variant.label)}>Salvar</button>
          </>}>
          <div className="fg"><label className="fl">Descrição</label><input className="fi" value={showEditVar.variant.label} onChange={e=>setShowEditVar(s=>({...s,variant:{...s.variant,label:e.target.value}}))} autoFocus /></div>
        </Sheet>
      )}

      {/* ── ADD ENTRY ── */}
      {showAddEntry && (
        <Sheet title="Adicionar Preço" onClose={() => setShowAddEntry(null)}
          footer={<><button className="btn btn-s" onClick={() => setShowAddEntry(null)}>Cancelar</button><button className="btn btn-p" onClick={() => addEntry(showAddEntry)}>Salvar</button></>}>
          <PriceFields entry={newEntry} onChange={setNewEntry} stores={stores} setStores={setStores} rates={rates} base={base} />
        </Sheet>
      )}

      {/* ── EDIT ENTRY ── */}
      {showEditEntry && (
        <Sheet title="Editar Preço" onClose={() => setShowEditEntry(null)}
          footer={<>
            <button className="btn btn-d" style={{flex:"none",padding:"14px 16px"}} onClick={() => { delEntry(showEditEntry.ctx, showEditEntry.entry.id); setShowEditEntry(null); }}>🗑</button>
            <button className="btn btn-s" onClick={() => setShowEditEntry(null)}>Cancelar</button>
            <button className="btn btn-p" onClick={() => saveEntry(showEditEntry.ctx, showEditEntry.entry)}>Salvar</button>
          </>}>
          <PriceFields entry={showEditEntry.entry} onChange={e => setShowEditEntry(s => ({...s, entry:e}))} stores={stores} setStores={setStores} rates={rates} base={base} />
        </Sheet>
      )}
      {/* ── CAMERA ── */}
      {showCamera && (
        <CameraSheet
          onCapture={(url) => {
            if (showCamera.onSave) showCamera.onSave(url);
            else setProducts(p => p.map(pr => pr.id !== showCamera.prodId ? pr : {...pr, photo:url}));
            setShowCamera(null);
          }}
          onClose={() => setShowCamera(null)}
        />
      )}
    </div>
  );
}

// ─── STORES TAB ──────────────────────────────────────────────────────────────
function StoresTab({ products, setProducts, stores, setStores, rates, convCurrency, base, addToast }) {
  const [expandedStore,  setExpandedStore]  = useState(null);
  const [showAddStore,   setShowAddStore]   = useState(false);
  const [showEditStore,  setShowEditStore]  = useState(null);
  const [showAddProduct, setShowAddProduct] = useState(null);
  const [newStore, setNewStore] = useState({ name:"", currency:"USD" });

  // add-product-to-store state
  const [apMode,    setApMode]    = useState("existing");
  const [apSearch,  setApSearch]  = useState("");
  const [apProd,    setApProd]    = useState(null);
  const [apVariant, setApVariant] = useState(null);
  const [apNewVarL, setApNewVarL] = useState("");
  const [apNP,      setApNP]      = useState({ name:"", category:"", varLabel:"" });
  const [apEntry,   setApEntry]   = useState({ amount:0, currency:"USD", link:"" });

  function addStore() {
    if (!newStore.name.trim()) return;
    setStores(s => [...s, { id:uid(), name:newStore.name.trim(), currency:newStore.currency }]);
    setNewStore({ name:"", currency:"USD" }); setShowAddStore(false);
  }
  function saveStore(st) {
    setStores(s => s.map(x => x.id !== st.id ? x : { ...x, name:st.name.trim(), currency:st.currency }));
    setShowEditStore(null);
  }
  function delStore(id) {
    setStores(s => s.filter(x => x.id !== id));
    if (expandedStore === id) setExpandedStore(null);
  }

  function openAdd(storeId) {
    const store = stores.find(s => s.id === storeId);
    setShowAddProduct(storeId);
    setApMode("existing"); setApSearch(""); setApProd(null); setApVariant(null);
    setApNewVarL(""); setApNP({ name:"", category:"", varLabel:"" });
    // Pre-fill currency from store
    setApEntry({ amount:0, currency: store?.currency || "USD", link:"" });
  }

  function getStoreItems(storeId) {
    const items = [];
    products.forEach(prod => {
      if (!prod.hasVariants) {
        (prod.prices||[]).filter(e => e.storeId === storeId).forEach(e => {
          items.push({ prod, variant:null, entry:e });
        });
      } else {
        (prod.variants||[]).forEach(v => {
          v.prices.filter(e => e.storeId === storeId).forEach(e => {
            items.push({ prod, variant:v, entry:e });
          });
        });
      }
    });
    return items;
  }

  function delStoreEntry(prod, variant, entryId) {
    if (!variant) {
      setProducts(p => p.map(pr => pr.id !== prod.id ? pr : { ...pr, prices:(pr.prices||[]).filter(e => e.id !== entryId), favorite:pr.favorite===entryId?null:pr.favorite }));
    } else {
      setProducts(p => p.map(pr => pr.id !== prod.id ? pr : { ...pr, variants:pr.variants.map(v => v.id !== variant.id ? v : { ...v, prices:v.prices.filter(e => e.id !== entryId), favorite:v.favorite===entryId?null:v.favorite }) }));
    }
  }

  const filteredProds = useMemo(() => {
    if (!apSearch.trim()) return products;
    const q = apSearch.toLowerCase();
    return products.filter(p => p.name.toLowerCase().includes(q) || p.category.toLowerCase().includes(q));
  }, [products, apSearch]);

  function handleSave() {
    const storeId = showAddProduct;
    if (!apEntry.amount) return;
    const entryObj = { id:uid(), storeId, amount:apEntry.amount, currency:apEntry.currency, link:apEntry.link };

    if (apEntry.currency !== base && !rates[apEntry.currency]) {
      addToast({ type:"warn", title:"Taxa não configurada", body:`Valor salvo em ${apEntry.currency}. Configure na aba Conversão.` });
    }

    if (apMode === "existing" && apProd) {
      if (!apProd.hasVariants) {
        setProducts(p => p.map(pr => pr.id !== apProd.id ? pr : { ...pr, prices:[...(pr.prices||[]),entryObj] }));
      } else if (apVariant) {
        setProducts(p => p.map(pr => pr.id !== apProd.id ? pr : { ...pr, variants:pr.variants.map(v => v.id !== apVariant.id ? v : { ...v, prices:[...v.prices,entryObj] }) }));
      } else {
        const newV = { id:uid(), label:apNewVarL.trim()||"Padrão", favorite:null, prices:[entryObj] };
        setProducts(p => p.map(pr => pr.id !== apProd.id ? pr : { ...pr, variants:[...pr.variants,newV] }));
      }
    } else if (apMode === "new" && apNP.name.trim()) {
      const isVar = apNP.varLabel.trim() !== "";
      const newP = {
        id:uid(), name:apNP.name.trim(), category:apNP.category.trim(),
        hasVariants: isVar,
        ...(isVar
          ? { variants:[{ id:uid(), label:apNP.varLabel.trim(), favorite:null, prices:[entryObj] }] }
          : { prices:[entryObj], favorite:null }
        )
      };
      setProducts(p => [...p, newP]);
    }
    setShowAddProduct(null);
  }

  const storeForSheet = stores.find(s => s.id === showAddProduct);
  const canSave = apEntry.amount && (
    (apMode === "existing" && apProd && (!apProd.hasVariants || apVariant || apNewVarL.trim())) ||
