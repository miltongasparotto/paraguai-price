            </select>
          </div>
        </Sheet>
      )}

      {/* ADD PRODUCT TO STORE */}
      {showAddProduct && storeForSheet && (
        <Sheet title={`${storeFlag(storeForSheet)} ${storeForSheet.name}`} onClose={() => setShowAddProduct(null)}
          footer={<>
            <button className="btn btn-s" onClick={() => setShowAddProduct(null)}>Cancelar</button>
            <button className="btn btn-p" onClick={handleSave} disabled={!canSave} style={{opacity:canSave?1:.45}}>Salvar</button>
          </>}>

          <div style={{display:"flex",gap:8}}>
            <button className={`btn ${apMode==="existing"?"btn-p":"btn-s"}`} style={{fontSize:13,padding:"10px 12px"}}
              onClick={() => { setApMode("existing"); setApProd(null); setApVariant(null); setApNewVarL(""); setApSearch(""); }}>
              📦 Da lista
            </button>
            <button className={`btn ${apMode==="new"?"btn-p":"btn-s"}`} style={{fontSize:13,padding:"10px 12px"}}
              onClick={() => { setApMode("new"); setApProd(null); }}>
              ✨ Novo
            </button>
          </div>

          {apMode === "existing" ? (
            !apProd ? (
              <div className="fg">
                <label className="fl">Buscar produto</label>
                <input className="fi" placeholder="Nome ou categoria..." value={apSearch} onChange={e=>setApSearch(e.target.value)} autoFocus />
                {filteredProds.length === 0 ? (
                  <div style={{padding:14,textAlign:"center",color:"var(--muted)",fontSize:13}}>Nenhum encontrado</div>
                ) : (
                  <div className="prod-pick-list">
                    {filteredProds.map(p => (
                      <div key={p.id} className="prod-pick-item" onClick={() => { setApProd(p); setApVariant(null); setApNewVarL(""); }}>
                        <div style={{fontWeight:600}}>{p.name}</div>
                        {p.category && <div style={{fontSize:11,color:"var(--muted)"}}>{p.category}</div>}
                        <div style={{fontSize:10,color:p.hasVariants?"var(--orange)":"var(--accent)",marginTop:2}}>{p.hasVariants?"⎇ com variações":"produto simples"}</div>
